{
  "$defs": {
    "AiTriageConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "playbook_file": {
          "default": ".github/skills/triage-radar/SKILL.md",
          "title": "Playbook File",
          "type": "string"
        },
        "known_patterns_file": {
          "default": ".github/skills/triage-radar/references/known-patterns.md",
          "title": "Known Patterns File",
          "type": "string"
        },
        "ownership_file": {
          "default": ".github/skills/triage-radar/references/ownership-and-filing.md",
          "title": "Ownership File",
          "type": "string"
        },
        "investigation_toolkit_file": {
          "default": ".github/skills/triage-radar/references/investigation-toolkit.md",
          "title": "Investigation Toolkit File",
          "type": "string"
        },
        "section_verdict_rules": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Section Verdict Rules",
          "type": "object"
        }
      },
      "title": "AiTriageConfig",
      "type": "object"
    },
    "SectionConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "ordering": {
          "title": "Ordering",
          "type": "integer"
        },
        "signal_kinds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Signal Kinds",
          "type": "array"
        },
        "threshold": {
          "default": 1,
          "minimum": 1,
          "title": "Threshold",
          "type": "integer"
        },
        "grouping_key": {
          "default": "component",
          "title": "Grouping Key",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "ordering",
        "signal_kinds"
      ],
      "title": "SectionConfig",
      "type": "object"
    },
    "SourceConfig": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "retries": {
          "default": 2,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "SourceConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "team_id": {
      "minLength": 1,
      "title": "Team Id",
      "type": "string"
    },
    "config_revision": {
      "minLength": 1,
      "title": "Config Revision",
      "type": "string"
    },
    "time_zone": {
      "default": "UTC",
      "title": "Time Zone",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceConfig"
      },
      "title": "Sources",
      "type": "array"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/SectionConfig"
      },
      "title": "Sections",
      "type": "array"
    },
    "tracker": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tracker"
    },
    "suppression_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suppression File"
    },
    "ai_triage": {
      "$ref": "#/$defs/AiTriageConfig"
    }
  },
  "required": [
    "team_id",
    "config_revision"
  ],
  "title": "TeamConfig",
  "type": "object"
}
