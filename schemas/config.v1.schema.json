{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncalldigest.dev/schemas/config.v1.schema.json",
  "title": "OnCallDigest team configuration",
  "type": "object",
  "required": ["team_id", "config_revision", "time_zone", "sources", "sections"],
  "properties": {
    "team_id": {"type": "string", "minLength": 1},
    "config_revision": {"type": "string", "minLength": 1},
    "time_zone": {"type": "string", "default": "UTC"},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "tracker": {"type": ["object", "null"]}
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "default": 30},
        "retries": {"type": "integer", "minimum": 0, "default": 2},
        "settings": {"type": "object"}
      },
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "ordering", "signal_kinds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "ordering": {"type": "integer"},
        "signal_kinds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "threshold": {"type": "integer", "minimum": 1, "default": 1},
        "grouping_key": {"type": "string", "default": "component"}
      },
      "additionalProperties": false
    }
  }
}
