# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit .env or place it in a production container image.

# Azure Data Explorer cluster endpoint, for example https://cluster.region.kusto.windows.net
ADX_ENDPOINT=https://<cluster>.<region>.kusto.windows.net
# ADX database containing the configured KQL tables
ADX_DATABASE=<database-name>
# KQL query used by the configured log-query source
ERROR_HEALTH_QUERY=<KQL-query>
# Fixture or live mode for the minimal example log-query source
LOG_QUERY_MODE=fixture
# Fixture path for the minimal example log-query source
LOG_QUERY_FIXTURE=fixtures/log_query_rows.json
# Fixture or live mode for the minimal example Azure DevOps tracker
AZDO_MODE=fixture
# Fixture path for the minimal example Azure DevOps tracker
AZDO_FIXTURE=fixtures/azure_devops_work_items.json
# Optional explicit ADX bearer token fallback; prefer DefaultAzureCredential.
ADX_TOKEN=
# Azure DevOps organization name
AZDO_ORGANIZATION=<organization>
# Azure DevOps project name
AZDO_PROJECT=<project>
# Azure DevOps personal access token fallback; prefer workload identity/OIDC.
AZDO_TOKEN=
# Azure DevOps API token environment variable name referenced by config
AZDO_TOKEN_ENV=AZDO_TOKEN
# Read-only WIQL query for the Azure DevOps tracker
AZDO_WIQL=<WIQL-query>
# Optional Azure tenant for explicit credential configuration
AZURE_TENANT_ID=
# Optional Azure client ID for workload identity or service principal auth
AZURE_CLIENT_ID=
# Optional Azure client secret fallback; never commit a value
AZURE_CLIENT_SECRET=
# Optional webhook destination for a later Teams/Slack delivery adapter
WEBHOOK_URL=
